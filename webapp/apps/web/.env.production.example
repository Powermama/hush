NODE_ENV=production
PORT=3000
HUSH_PUBLIC_BASE_URL=https://behu.sh
HUSH_SHORT_BASE_URL=https://behu.sh
HUSH_ALLOWED_ORIGIN=https://behu.sh
HUSH_DATA_DIR=/app/data
# The service generates its signing key itself (see docs/operations/coolify-deployment.md).
# Only for an externally managed key, set both:
# HUSH_SERVICE_KEY_ID=hush-external-1
# HUSH_SERVICE_PRIVATE_JWK={"kty":"EC","crv":"P-256","x":"replace","y":"replace","d":"replace","key_ops":["sign"],"ext":true}
DATABASE_URL=postgresql://hush:replace@postgres:5432/hush
# Blog funnel (PRD R10), off while unset. Only after the privacy policy update
# has been reviewed (docs/legal-review.md, item 6):
# HUSH_UMAMI_URL=https://umami.example.com
# HUSH_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
