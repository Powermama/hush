{
  "name": "@hush/cms",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "lint": "tsc -p .",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "cms:publish-due": "bun src/jobs/publish-due.ts",
    "cms:token": "bun src/commands/create-token.ts",
    "api:openapi": "bun src/export-openapi.ts",
    "api:check": "bun run api:openapi && git diff --exit-code -- openapi/hush-cms.json",
    "cms:import": "bun src/commands/import.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.1.5",
    "@hush/article": "workspace:*",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.18",
    "postgres": "3.4.7",
    "sharp": "0.35.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/bun": "1.3.9",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}
