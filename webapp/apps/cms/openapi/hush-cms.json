                      "local-ai",
                      "speech-models",
                      "voice-writing",
                      "typing-less",
                      "verified-messages"
                    ]
                  },
                  "author": {
                    "type": "string",
                    "enum": [
                      "clemens-kressmann"
                    ]
                  },
                  "imageAlt": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 160
                  },
                  "markdown": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "title",
                  "description",
                  "slug",
                  "lang",
                  "keyword",
                  "secondaryKeywords",
                  "type",
                  "cluster",
                  "author",
                  "imageAlt",
                  "markdown"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new draft",
