{
  "openapi": "3.1.0",
  "info": {
    "title": "hush CMS",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Post": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 50,
            "maxLength": 60
          },
          "description": {
            "type": "string",
            "minLength": 140,
            "maxLength": 160
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "de"
            ]
          },
          "keyword": {
            "type": "string",
            "minLength": 2
          },
          "secondaryKeywords": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2
            },
            "maxItems": 8
          },
          "type": {
            "type": "string",
            "enum": [
              "how-to",
              "comparison",
              "guide",
              "listicle",
              "essay",
              "news"
            ]
          },
          "cluster": {
            "type": "string",
            "enum": [
              "local-dictation",
              "dictation-on-mac",
              "local-ai",
              "speech-models",
              "voice-writing",
              "typing-less",
              "verified-messages"
            ]
          },
          "author": {
            "type": "string",
            "enum": [
              "clemens-kressmann"
            ]
          },
          "imageAlt": {
            "type": "string",
            "minLength": 10,
            "maxLength": 160
          },
          "markdown": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "scheduled",
              "published"
            ]
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "rendition": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "heading": {
                "type": "string"
              },
              "html": {
                "type": "string"
              },
              "toc": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "text"
                  ]
                }
              },
              "readingMinutes": {
                "type": "integer"
              },
              "renderedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "heading",
              "html",
              "toc",
              "readingMinutes",
              "renderedAt"
            ],
            "description": "What the post renders to; present while it is scheduled or published."
          }
        },
        "required": [
          "title",
          "description",
          "slug",
          "lang",
          "keyword",
          "secondaryKeywords",
          "type",
          "cluster",
          "author",
          "imageAlt",
          "markdown",
          "id",
          "status",
          "publishedAt",
          "createdAt",
          "updatedAt",
          "rendition"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "problems": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Revision": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "postId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "scheduled",
              "published"
            ]
          },
          "snapshot": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 50,
                "maxLength": 60
              },
              "description": {
                "type": "string",
                "minLength": 140,
                "maxLength": 160
              },
              "slug": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "lang": {
                "type": "string",
                "enum": [
                  "en",
                  "de"
                ]
              },
              "keyword": {
                "type": "string",
                "minLength": 2
              },
              "secondaryKeywords": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 2
                },
                "maxItems": 8
              },
              "type": {
                "type": "string",
                "enum": [
                  "how-to",
                  "comparison",
                  "guide",
                  "listicle",
                  "essay",
                  "news"
                ]
              },
              "cluster": {
                "type": "string",
                "enum": [
                  "local-dictation",
                  "dictation-on-mac",
                  "local-ai",
                  "speech-models",
                  "voice-writing",
                  "typing-less",
                  "verified-messages"
                ]
              },
              "author": {
                "type": "string",
                "enum": [
                  "clemens-kressmann"
                ]
              },
              "imageAlt": {
                "type": "string",
                "minLength": 10,
                "maxLength": 160
              },
              "markdown": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "title",
              "description",
              "slug",
              "lang",
              "keyword",
              "secondaryKeywords",
              "type",
              "cluster",
              "author",
              "imageAlt",
              "markdown"
            ],
            "additionalProperties": false
          },
          "actor": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "postId",
          "status",
          "snapshot",
          "actor",
          "createdAt"
        ]
      },
      "Media": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "contentType",
          "sha256",
          "sizeBytes",
          "width",
          "height",
          "createdAt"
        ]
      }
    },
    "parameters": {}
  },
