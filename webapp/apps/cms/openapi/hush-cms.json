                "published"
              ]
            },
            "required": false,
            "name": "status",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Posts, most recently changed first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
