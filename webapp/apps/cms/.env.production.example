# Runtime settings for hush-cms (webapp/apps/cms/compose.yaml). Real values
# live in the platform's secret store (Coolify: Environment Variables, locked,
# runtime only), never in Git.

# The CMS database password. Coolify generates SERVICE_PASSWORD_64_* values;
# elsewhere, set it to a long random string.
SERVICE_PASSWORD_64_CMSPOSTGRES=replace

# Article images: a Cloudflare R2 bucket and a token limited to it.
CMS_S3_BUCKET=hush-blog-media
CMS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CMS_S3_ACCESS_KEY_ID=replace
CMS_S3_SECRET_ACCESS_KEY=replace

# Database backups: a separate private bucket and a token limited to it.
CMS_BACKUP_S3_BUCKET=hush-cms-backups
CMS_BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CMS_BACKUP_S3_ACCESS_KEY_ID=replace
CMS_BACKUP_S3_SECRET_ACCESS_KEY=replace
CMS_BACKUP_KEEP_DAYS=30

# Without buckets, images and backups can live on persistent volumes instead:
# CMS_MEDIA_DIR=/app/data/media
# CMS_BACKUP_DIR=/app/data/backups
