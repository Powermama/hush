{
  "name": "@hush/cms-admin",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names admin,cms --prefix-colors blue,magenta \"vite\" \"CMS_ADMIN_ORIGIN=http://localhost:5174 bun run --cwd ../cms admin:server\"",
    "build": "bun run routes && tsc -b && vite build",
    "lint": "bun run routes && tsc -b --pretty false",
    "test": "bun test src",
    "api:client": "orval",
    "api:check": "bun run api:client && git diff --exit-code -- src/api/cms.generated.ts",
    "routes": "tsr generate"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@hush/article": "workspace:*",
    "@hush/theme": "workspace:*",
    "@lexical/code": "0.53.0",
    "@lexical/link": "0.53.0",
    "@lexical/list": "0.53.0",
    "@lexical/markdown": "0.53.0",
    "@lexical/react": "0.53.0",
    "@lexical/rich-text": "0.53.0",
    "@lexical/selection": "0.53.0",
    "@lexical/table": "0.53.0",
    "@lexical/utils": "0.53.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lexical": "0.53.0",
    "lucide-react": "1.73.0",
    "radix-ui": "1.8.1",
    "react": "19.2.8",
    "react-day-picker": "10.0.2",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@lexical/headless": "0.53.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query-devtools": "5.107.1",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/router-cli": "1.168.0",
    "@tanstack/router-plugin": "1.169.0",
    "@types/bun": "1.3.9",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.7",
    "orval": "8.48.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.2.4"
  }
}
