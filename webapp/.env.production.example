NODE_ENV=production
PORT=3000
HUSH_PUBLIC_BASE_URL=https://behu.sh
HUSH_SHORT_BASE_URL=https://behu.sh
HUSH_ALLOWED_ORIGIN=https://behu.sh
HUSH_DATA_DIR=/app/data
HUSH_SERVICE_KEY_ID=hush-production-1
# Optional external key-management override:
# HUSH_SERVICE_PRIVATE_JWK={"kty":"EC","crv":"P-256","x":"replace","y":"replace","d":"replace","key_ops":["sign"],"ext":true}
DATABASE_URL=postgresql://hush:replace@postgres:5432/hush
