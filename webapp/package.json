{
  "name": "hush-landing",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names web,api --prefix-colors blue,magenta \"bun run dev:web\" \"bun run dev:api\"",
    "dev:web": "vite",
    "dev:api": "bun --watch server/index.ts",
    "site:generate": "bun scripts/generate-site-files.ts",
    "build": "bun run site:generate && tsc -b && vite build",
    "build:api": "bun build server/index.ts --target=bun --outdir=dist-server",
    "serve:e2e": "NODE_ENV=test PORT=4173 HUSH_PUBLIC_BASE_URL=http://127.0.0.1:4173 bun server/index.ts",
    "api:openapi": "bun server/export-openapi.ts",
    "api:check": "bun run api:openapi && git diff --exit-code -- openapi/hush-provenance.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun server/db/migrate.ts",
    "key:generate": "bun scripts/generate-service-key.ts",
    "preview": "vite preview",
    "lint": "tsc -b --pretty false",
    "test": "bun test server",
    "test:e2e": "bun run build && playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.883.0",
    "@aws-sdk/s3-request-presigner": "3.883.0",
    "@hono/zod-openapi": "1.1.5",
    "@tanstack/react-router": "1.170.18",
    "diff": "8.0.2",
    "drizzle-orm": "0.44.5",
    "hono": "4.9.6",
    "ktx-parse": "2.0.0",
    "motion": "12.43.0",
    "postgres": "3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simple-icons": "16.12.0",
    "three": "0.187.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.9",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "drizzle-kit": "0.31.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  },
  "packageManager": "bun@1.3.9",
  "engines": {
    "bun": ">=1.3.9"
  }
}
